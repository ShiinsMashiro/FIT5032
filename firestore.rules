rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Trips collection:
    // Anyone can read trips to view community statistics and tables.
    // Only authenticated users can create, update, or delete trips.
    match /trips/{tripId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Reviews collection:
    // Anyone can read community route reviews.
    // Only authenticated users can submit or manage reviews.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Users collection:
    // Anyone can read basic public profile data.
    // Users can only update their own profile document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
